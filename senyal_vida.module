<?php

/**
 * Implements hook_theme().
 */
function senyal_vida_theme($existing, $type, $theme, $path) {
  return [
    'my_template' => [
      'variables' => [
        'address' => NULL,
        'postal_code' => NULL,
        'city' => NULL,
        'country' => NULL,
        'found' => NULL,
        'form' => NULL,
      ],
    ],
    'my_template-2' => [
      'variables' => [
        'address' => NULL,
        'postal_code' => NULL,
        'city' => NULL,
        'country' => NULL,
        'created' => NULL,
      ],
    ],
  ];
}

function senyal_vida_locale_translation_projects_alter(&$projects) {
  $path = \Drupal::service('extension.list.module')->getPath('senyal_vida');
  $projects['senyal_vida']['info']['interface translation server pattern'] = $path . '/translations/%project.%language.po';
}